# .env.example 을 복사해 .env 로 만들어 사용한다. (.env 는 Git에 올리지 않는다)

# Supabase 대시보드 → Project Settings → API Keys / Data API
# publishable 키만 넣는다. secret / service_role 키는 RLS를 우회하므로 절대 넣지 않는다.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# 데모 로그인 계정 (supabase/seed.sql 에서 역할을 부여한 테스트 전용 계정)
# 서버만 이 값을 알고, 브라우저에는 전달되지 않는다.
DEMO_WORKER_EMAIL=demo-worker@example.com
DEMO_WORKER_PASSWORD=
DEMO_MANAGER_EMAIL=demo-manager@example.com
DEMO_MANAGER_PASSWORD=

# 세션 쿠키 Secure 속성: 로컬(http://localhost)은 false, 배포(https)는 true
COOKIE_SECURE=false

# 데이터를 바꾸는 요청을 허용할 추가 출처(Origin). 비워 두면 앱 자신의 주소만 허용
ALLOWED_ORIGINS=

# --- RLS 검증 스크립트(scripts/rls_check.py) 전용: 다른 작업자 계정 (선택) ---
# 작업자끼리 서로의 신고를 못 보는지 확인할 때 사용한다. 없으면 해당 항목은 건너뛴다.
RLS_TEST_WORKER2_EMAIL=
RLS_TEST_WORKER2_PASSWORD=
